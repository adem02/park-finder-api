{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/integration/.+\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/test/integration/support/database/global-setup.ts",
  "globalTeardown": "<rootDir>/test/integration/support/database/global-teardown.ts",
  "testTimeout": 30000
}
