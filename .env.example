NODE_ENV=development
# Comma-separated list of allowed front-end origins (credentials are enabled, so no * in production)
CORS_ORIGIN=http://localhost:5190,http://localhost:4190
BASE_URL=http://localhost:3000
# PWA base URL: social sign-in redirects the browser back there
FRONTEND_URL=http://localhost:5190
PORT=3000

# Database
DB_USER=user
DB_PASSWORD=password
DB_NAME=database
DB_HOST=host
DB_PORT=5432
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Connection pool (optional): hosted plans such as Supabase Free cap connections
# DATABASE_POOL_MAX=10
# TLS to the database (optional): off (default, local Docker) | verify (production,
# with DATABASE_SSL_CA = the provider's CA certificate in PEM) | no-verify (encrypted only)
# DATABASE_SSL=off
# DATABASE_SSL_CA=

# Redis (optional, not used by the app yet)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
JWT_EXPIRES_IN=15m

# Refresh token cookie (optional)
# REFRESH_COOKIE_SECURE defaults to true in production, false otherwise.
# REFRESH_COOKIE_SAME_SITE defaults to strict; use none only if the front and the API are on different sites (forces Secure).
# REFRESH_COOKIE_SECURE=false
# REFRESH_COOKIE_SAME_SITE=strict

# Google OAuth
# The API refuses to start with an empty client ID: keep these placeholders until
# Google sign-in is configured (Google login simply won't work with them).
GOOGLE_CLIENT_ID=not-configured
GOOGLE_CLIENT_SECRET=not-configured
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Apple OAuth (same: placeholders until Apple sign-in is configured)
APPLE_CLIENT_ID=not-configured
APPLE_TEAM_ID=not-configured
APPLE_KEY_ID=not-configured
APPLE_PRIVATE_KEY=not-configured
APPLE_CALLBACK_URL=http://localhost:3000/auth/apple/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=